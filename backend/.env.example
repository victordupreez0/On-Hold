SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Port 6543 = transaction pooler (required on Vercel); 5432 = session pooler (fine for a local server)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Speech-to-text for "Speak": Cloudflare Workers AI (token needs Workers AI Read + Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CORS_ORIGINS=http://localhost:8081
# Seed only: the admin demo account's password (never the published demo one once deployed)
ADMIN_PASSWORD=
